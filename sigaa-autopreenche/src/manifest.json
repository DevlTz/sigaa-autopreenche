{
  "manifest_version": 3,
  "name": "SIGAA AutoPreenche",
  "version": "1.3.0",
  "description": "Salva, restaura e reutiliza respostas do Cadastro Unico do SIGAA UFRN localmente no navegador.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://sigaa.ufrn.br/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://sigaa.ufrn.br/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
